# Pusher Channels credentials (https://dashboard.pusher.com -> your app -> App Keys)
# IMPORTANT: enable "Client events" in the Pusher app settings.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Upstash Redis (accounts, leaderboard, quick match).
# Adding Upstash from the Vercel Marketplace sets KV_REST_API_URL / KV_REST_API_TOKEN automatically;
# either naming works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
